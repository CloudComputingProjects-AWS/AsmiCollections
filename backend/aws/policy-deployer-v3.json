{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ECRPushDev",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:762813627344:repository/ashmi-backend",
        "arn:aws:ecr:ap-south-1:762813627344:repository/ashmi-image-processor",
        "arn:aws:ecr:ap-southeast-1:762813627344:repository/ashmi-backend-sg-dev",
        "arn:aws:ecr:ap-southeast-1:762813627344:repository/ashmi-image-processor-sg-dev"
      ]
    },
    {
      "Sid": "LambdaDeployDev",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:ap-south-1:762813627344:function:ashmi-backend-dev",
        "arn:aws:lambda:ap-south-1:762813627344:function:ashmi-image-processor-dev",
        "arn:aws:lambda:ap-southeast-1:762813627344:function:ashmi-backend-dev-sg",
        "arn:aws:lambda:ap-southeast-1:762813627344:function:ashmi-image-processor-dev-sg"
      ]
    },
    {
      "Sid": "S3DeployDevFrontend",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::ashmi-dev-frontend",
        "arn:aws:s3:::ashmi-dev-frontend/*",
        "arn:aws:s3:::ashmi-dev-frontend-sg",
        "arn:aws:s3:::ashmi-dev-frontend-sg/*"
      ]
    },
    {
      "Sid": "CloudFrontInvalidateDev",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "*"
    }
  ]
}
